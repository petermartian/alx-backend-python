# messaging_app/Jenkinsfile (for tasks 0 and 1 combined, as task 1 extends it)
pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/petermartian/alx-backend-python.git', branch: 'main', credentialsId: 'github-credentials'
            }
        }
        stage('Install Dependencies') {
            steps {
                dir('messaging_app') {
                    sh 'pip install -r requirements.txt'
                }
            }
        }
        stage('Run Tests') {
            steps {
                dir('messaging_app') {
                    sh 'pytest --junitxml=test-report.xml'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('messaging_app') {
                    sh 'docker build -t petermartian/messaging-app:latest .'
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                withDockerRegistry([credentialsId: 'docker-hub-credentials', url: '']) {
                    sh 'docker push petermartian/messaging-app:latest'
                }
            }
        }
    }
    post {
        always {
            junit 'messaging_app/test-report.xml'
        }
    }
}
